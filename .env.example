# Copy to .env and fill in. Never commit .env.
# Both values come from Supabase: Connect button or Project Settings > API.
# Use the publishable (anon) key only. NEVER put the service_role key in this app.
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR-PUBLISHABLE-KEY
